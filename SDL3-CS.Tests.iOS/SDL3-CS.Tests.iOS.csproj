<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0-ios26.0</TargetFramework>
    <RootNamespace>SDL.Tests.iOS</RootNamespace>
    <OutputType>Exe</OutputType>
    <Nullable>enable</Nullable>
    <ImplicitUsings>true</ImplicitUsings>
    <SupportedOSPlatformVersion>13.0</SupportedOSPlatformVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <CodesignKey>iPhone Developer</CodesignKey>
    <_XcodeVersionCheckEnforced>false</_XcodeVersionCheckEnforced>
  </PropertyGroup>

  <PropertyGroup Label="NuGet">
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\SDL3-CS.Tests\SDL3-CS.Tests.csproj" PrivateAssets="all" ExcludeAssets="contentfiles;build;native">
      <Properties>SkipMacNativeLibs=true</Properties>
    </ProjectReference>
  </ItemGroup>

  <ItemGroup>
    <Content Remove="**\*.dylib" />
    <None Remove="**\*.dylib" />
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="..\native\ios\SDL3.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
    <NativeReference Include="..\native\ios\SDL3_image.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
    <NativeReference Include="..\native\ios\SDL3_mixer.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
    <NativeReference Include="..\native\ios\SDL3_ttf.xcframework">
      <Kind>Framework</Kind>
    </NativeReference>
  </ItemGroup>

  <ItemGroup>
    <NativeReference Include="$(MSBuildThisFileDirectory)..\native\ios\SDL3.xcframework"/>
    <NativeReference Include="$(MSBuildThisFileDirectory)..\native\ios\SDL3_image.xcframework"/>
    <NativeReference Include="$(MSBuildThisFileDirectory)..\native\ios\SDL3_ttf.xcframework"/>
    <NativeReference Include="$(MSBuildThisFileDirectory)..\native\ios\SDL3_mixer.xcframework"/>
  </ItemGroup>

</Project>
